# Copy to .env and fill in. These live in n8n credentials in practice —
# this file just documents what the workflow needs. Never commit the real .env.

# ChatGPT Ads Conversions API (Ads Manager -> Conversions tab)
CONVERSION_KEY=your-conversions-api-key
PIXEL_ID=your-kommo-lead-pixel-id

# Kommo MCP (Altegio) — machine token, scope mcp:kommo:read
MCP_MACHINE_TOKEN=your-kommo-mcp-machine-token

# Endpoints (reference only)
CHATGPT_ADS_ENDPOINT=https://bzr.openai.com/v1/events
KOMMO_MCP_ENDPOINT=https://mcp.alteg.io/kommo/br/mcp
